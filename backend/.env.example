GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# PDF/DOCX extraction caps for speed
MAX_PDF_PAGES=12
MAX_DOCX_PARAGRAPHS=250

# Upload/LLM limits
MAX_UPLOAD_BYTES=10485760
LLM_MAX_CHARS=12000

# LLM tuning
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT_SECONDS=90

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3000/,http://127.0.0.1:3000/,https://your-frontend-domain.com


